# MySQL (pakai huruf dan angka saja untuk MYSQL_PASSWORD karena dipakai di DATABASE_URL)
MYSQL_DATABASE=topup_game
MYSQL_USER=topup_app
MYSQL_PASSWORD=CHANGE_ME_HURUF_ANGKA_PANJANG_ACAK
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_HURUF_ANGKA_PANJANG_ACAK

# Backend. Buat JWT_SECRET dengan: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Lama sesi login (jam). Cookie sesi HttpOnly; set COOKIE_SECURE=false hanya untuk uji lewat http://IP sebelum HTTPS aktif.
SESSION_HOURS=8
COOKIE_SECURE=true
CORS_ORIGINS=https://mythtopplace.com

# Akun admin, dibuat saat backend pertama kali start. Isi nilai nyata dan beri tanda kutip
# bila ada karakter khusus, mis. ADMIN_PASSWORD="abc123#xyz". Jangan commit file .env.
ADMIN_EMAIL=ganti-dengan-email-admin@domainmu.com
ADMIN_PASSWORD=CHANGE_ME_PASSWORD_ADMIN_YANG_KUAT
# Ubah ke true sekali saja jika ingin menimpa password admin yang sudah ada, lalu kembalikan ke false.
ADMIN_PASSWORD_SYNC=false
# true: admin lain otomatis diturunkan menjadi user, hanya ADMIN_EMAIL yang jadi admin.
ADMIN_EXCLUSIVE=true

# Pengali harga data contoh saat database pertama kali diisi (mis. 20 untuk demo agar tidak ada yang membeli)
SEED_PRICE_MULTIPLIER=1
PENDING_TTL_MINUTES=10
IDLE_MINUTES=40
MAX_ACTIVE_ORDERS=3
# Batas permintaan per menit per IP (umum / login dan daftar). Naikkan bila banyak pengguna berbagi satu IP (jaringan seluler, kampus).
# RATE_LIMIT_PER_MIN=60  AUTH_RATE_LIMIT_PER_MIN=5
# Opsional, perlindungan beban (nilai bawaan sudah wajar): DB_WRITE_CONCURRENCY=8 MAX_INFLIGHT=400 HASH_CONCURRENCY=4

# Biaya admin per pembayaran (rupiah)
ADMIN_FEE=1500

# Tujuan pembayaran yang ditampilkan ke pembeli (gambar QRIS ada di frontend/src/assets/qris.jpeg)
PAY_MANDIRI_NAME=
PAY_MANDIRI_NUMBER=
PAY_DANA_NAME=
PAY_DANA_NUMBER=

# Port publik container frontend. Default 80. Jika HTTPS lewat Caddy di host: 127.0.0.1:8080
FRONTEND_BIND=80
